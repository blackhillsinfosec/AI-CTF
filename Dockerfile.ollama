# Pinned to 0.24.0: the 0.30.x series dropped support for the 'mllama'
# architecture used by llama3.2-vision:11b (Challenge 11), failing with
# "unknown model architecture: 'mllama'". 0.24.0 is the last release before the
# 0.30 line. Do not bump without confirming llama3.2-vision:11b still loads.
FROM ollama/ollama:0.24.0

# Create a startup script that pulls the model after Ollama starts
RUN mkdir -p /scripts
COPY <<EOF /scripts/startup.sh
#!/bin/bash

# Start Ollama in the background
/bin/ollama serve &
OLLAMA_PID=$!

# Wait for Ollama to be ready
echo "Waiting for Ollama to start..."
sleep 10

# Check if the model already exists
if ! ollama list | grep -q "llama3.1:8b"; then
    echo "Pulling llama3.1:8b model..."
    ollama pull llama3.1:8b
    echo "Model pull complete!"
else
    echo "Model llama3.1:8b already exists, skipping pull."
fi

# Check if the model already exists
if ! ollama list | grep -q "llama3.2-vision:11b"; then
    echo "Pulling llama3.2-vision:11b model..."
    ollama pull llama3.2-vision:11b
    echo "Model pull complete!"
else
    echo "Model llama3.2-vision:11b already exists, skipping pull."
fi

# Keep Ollama running in the foreground
wait $OLLAMA_PID
EOF

RUN chmod +x /scripts/startup.sh

# Use the startup script as the entrypoint
ENTRYPOINT ["/scripts/startup.sh"]